<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for?(:title) ? "#{content_for(:title)} - Rails" : "Rails" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": Rails.env.production? ? "reload" : "" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": Rails.env.production? ? "reload" : "" %>
    <%= render "layouts/appearance" %>
    <%= javascript_importmap_tags %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>
  </head>
  <body class="font-sans antialiased">
    <%# `sidebarOpen` is the rail's state at md and up, `sidebarOpenMobile` the drawer's below
        it. One trigger drives whichever applies, and the rail's state is kept in
        a cookie so the next page renders the way this one was left. %>
    <div
      x-data="{
        sidebarOpen: <%= sidebar_open? %>,
        sidebarOpenMobile: false,
        toggle() {
          if (window.matchMedia('(max-width: 767px)').matches) {
            this.sidebarOpenMobile = ! this.sidebarOpenMobile
            return
          }
          this.sidebarOpen = ! this.sidebarOpen
          document.cookie = 'sidebar_state=' + this.sidebarOpen + '; path=/; max-age=604800; samesite=lax'
        }
      }"
      class="flex min-h-svh w-full bg-sidebar"
    >
      <%= render "layouts/sidebar" %>
      <div class="relative flex min-h-svh flex-1 flex-col overflow-hidden bg-background md:m-2 md:ml-0 md:rounded-xl md:shadow-sm">
        <%= render "layouts/sidebar_header" %>
        <main class="min-w-0 flex-1"><%= yield %></main>
      </div>
    </div>
  </body>
</html>
