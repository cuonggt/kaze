<%# The settings shell: a heading, the sub-nav down the side, and the page's own
    sections in the content column. %>
<div class="px-4 py-6">
  <%= render(HeadingComponent.new(title: 'Settings', description: 'Manage your profile and account settings')) %>
  <div class="flex flex-col lg:flex-row lg:space-x-12">
    <aside class="w-full max-w-xl lg:w-48">
      <nav class="flex flex-col space-y-1 space-x-0" aria-label="Settings">
        <% [
             { title: 'Profile', href: profile_edit_path },
             { title: 'Password', href: password_edit_path },
             { title: 'Appearance', href: appearance_edit_path }
           ].each do |item| %>
          <a href="<%= item[:href] %>" class="inline-flex h-8 w-full items-center justify-start gap-2 rounded-md px-3 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground <%= 'bg-muted' if current_page?(item[:href]) %>">
            <%= item[:title] %>
          </a>
        <% end %>
      </nav>
    </aside>
    <div class="my-6 h-px w-full bg-border lg:hidden"></div>
    <div class="flex-1 md:max-w-2xl">
      <section class="max-w-xl space-y-12">
        <%= yield %>
      </section>
    </div>
  </div>
</div>
