<% content_for(:breadcrumbs) do %>
  <%= render(BreadcrumbsComponent.new([ { title: 'Profile', href: profile_edit_path } ])) %>
<% end %>
<div class="flex h-full flex-1 flex-col gap-6 p-4">
  <div class="rounded-xl border border-sidebar-border/70 p-4 sm:p-8 dark:border-sidebar-border">
    <div class="max-w-xl">
      <%= render "profile/partials/update_appearance_form" %>
    </div>
  </div>
  <div class="rounded-xl border border-sidebar-border/70 p-4 sm:p-8 dark:border-sidebar-border">
    <div class="max-w-xl">
      <%= render "profile/partials/update_profile_information_form" %>
    </div>
  </div>
  <div class="rounded-xl border border-sidebar-border/70 p-4 sm:p-8 dark:border-sidebar-border">
    <div class="max-w-xl">
      <%= render "profile/partials/update_password_form" %>
    </div>
  </div>
  <div class="rounded-xl border border-sidebar-border/70 p-4 sm:p-8 dark:border-sidebar-border">
    <div class="max-w-xl">
      <%= render "profile/partials/delete_user_form" %>
    </div>
  </div>
</div>
