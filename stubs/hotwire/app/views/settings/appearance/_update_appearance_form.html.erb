<%# Alpine holds the preference; the buttons themselves are rendered here so the
    icons come through the same component the rest of the layout uses. %>
<div
  x-data="{
    preference: localStorage.getItem('appearance') || 'system',
    select(value) {
      this.preference = value
      localStorage.setItem('appearance', value)
      window.applyAppearance()
    }
  }"
  class="inline-flex gap-1 rounded-lg bg-neutral-100 p-1 dark:bg-neutral-800"
>
  <% [ [ 'light', 'Light', 'sun' ], [ 'dark', 'Dark', 'moon' ], [ 'system', 'System', 'monitor' ] ].each do |value, label, icon| %>
    <button
      type="button"
      @click="select('<%= value %>')"
      :aria-pressed="preference === '<%= value %>'"
      class="flex items-center rounded-md px-3.5 py-1.5 transition-colors outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
      :class="preference === '<%= value %>'
        ? 'bg-white shadow-xs dark:bg-neutral-700 dark:text-neutral-100'
        : 'text-neutral-500 hover:bg-neutral-200/60 hover:text-black dark:text-neutral-400 dark:hover:bg-neutral-700/60'"
    >
      <%= render(IconComponent.new(icon, classes: '-ml-1 h-4 w-4')) %>
      <span class="ml-1.5 text-sm"><%= label %></span>
    </button>
  <% end %>
</div>
