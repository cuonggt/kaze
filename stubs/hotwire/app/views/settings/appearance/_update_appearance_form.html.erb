<section
  x-data="{
    preference: localStorage.getItem('appearance') || 'system',
    select(value) {
      this.preference = value
      localStorage.setItem('appearance', value)
      window.applyAppearance()
    }
  }"
>
  <div class="inline-flex rounded-lg bg-gray-100 p-1 dark:bg-gray-900">
    <template x-for="option in [
      { value: 'light', label: 'Light' },
      { value: 'dark', label: 'Dark' },
      { value: 'system', label: 'System' }
    ]" :key="option.value">
      <button
        type="button"
        @click="select(option.value)"
        :aria-pressed="preference === option.value"
        class="rounded-md px-4 py-1.5 text-sm font-medium transition focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800"
        :class="preference === option.value
          ? 'bg-white text-gray-900 shadow-xs dark:bg-gray-700 dark:text-gray-100'
          : 'text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100'"
        x-text="option.label"
      ></button>
    </template>
  </div>
</section>
